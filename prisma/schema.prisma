// Academy Management System — Prisma Schema
// Status/category/method fields are plain Strings with the allowed values
// enforced in the application layer (see src/lib/constants.ts), so the
// schema stays portable and simple (no native enum type required).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Single row holding the academy's own info + system-wide defaults.
// Mirrors the old Company singleton pattern (see src/lib/data/settings.ts).
model Settings {
  id                  String   @id @default(cuid())
  academyName         String   @default("الأكاديمية")
  logo                String?
  phone               String?
  email                String?
  address             String?
  instagram           String?
  facebook             String?
  currency             String   @default("IQD")
  // Monotonically increasing counter consumed when issuing a certificate —
  // see src/lib/certificate.ts. Never decremented, even if a certificate is
  // later deleted, so numbers are never reused.
  certificateNextSeq  Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?
  // "ADMIN" | "STAFF" — see src/lib/constants.ts. Fixed two-role model,
  // no per-resource custom permissions (this is a small single-academy app).
  role         String   @default("STAFF")
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Instructor {
  id        String    @id @default(cuid())
  name      String
  phone     String?
  specialty String?
  notes     String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  courses Course[]
}

model Course {
  id               String    @id @default(cuid())
  name             String
  shortDescription String?
  category         String?
  instructorId     String?
  startDate        DateTime
  endDate          DateTime
  days             Int       @default(1)
  price            Float     @default(0)
  capacity         Int       @default(0)
  room             String?
  // DRAFT | OPEN | FULL | COMPLETED | CANCELLED
  status           String    @default("DRAFT")
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  instructor    Instructor?    @relation(fields: [instructorId], references: [id])
  registrations Registration[]
}

model Student {
  id         String    @id @default(cuid())
  fullName   String
  phone      String
  whatsapp   String?
  email      String?
  profession String?
  specialty  String?
  workplace  String?
  notes      String?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  registrations Registration[]
}

// A student's enrollment in one course. price is a snapshot of the course
// price at registration time, so a later price change on the Course never
// silently changes what an already-registered student owes.
model Registration {
  id          String    @id @default(cuid())
  studentId   String
  courseId    String
  price       Float
  // PENDING | CONFIRMED | CANCELLED | COMPLETED
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  student     Student      @relation(fields: [studentId], references: [id])
  course      Course       @relation(fields: [courseId], references: [id])
  payments    Payment[]
  attendance  Attendance[]
  certificate Certificate?

  @@index([studentId])
  @@index([courseId])
}

model Payment {
  id             String   @id @default(cuid())
  registrationId String
  amount         Float
  paymentDate    DateTime @default(now())
  // CASH | BANK_TRANSFER | OTHER
  method         String   @default("CASH")
  notes          String?
  createdAt      DateTime @default(now())

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
}

// One row per (registration, day) — dayNumber runs 1..Course.days, letting a
// multi-day course track attendance separately for each day.
model Attendance {
  id             String   @id @default(cuid())
  registrationId String
  dayNumber      Int
  // PRESENT | ABSENT
  status         String   @default("ABSENT")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([registrationId, dayNumber])
}

model Certificate {
  id                String   @id @default(cuid())
  registrationId    String   @unique
  certificateNumber String   @unique
  issueDate         DateTime @default(now())
  createdAt         DateTime @default(now())

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
}
