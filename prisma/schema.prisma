// Marketing Plan — Prisma Schema
// Note: status/type/category fields are plain Strings with the allowed
// values enforced in the application layer (see src/lib/constants.ts),
// and multi-select fields (e.g. campaign platforms) are stored as
// comma-separated strings, so the schema is portable across SQL providers.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id        String   @id @default(cuid())
  name      String
  logo      String?
  currency  String   @default("IQD")
  language  String   @default("ar")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brands Brand[]
  plans  Plan[]
  users  User[]
  roles  Role[]

  metaConnection MetaConnection?
}

model Brand {
  id        String   @id @default(cuid())
  companyId String
  name      String
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plans     Plan[]
  campaigns Campaign[]

  metaAdAccount MetaAdAccount?
}

model Plan {
  id          String    @id @default(cuid())
  companyId   String
  brandId     String?
  name        String
  description String?
  period      String?
  startDate   DateTime
  endDate     DateTime
  budget      Float     @default(0)
  mainGoal    String?
  status      String    @default("مخطط")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  brand      Brand?      @relation(fields: [brandId], references: [id])
  objectives Objective[]
  campaigns  Campaign[]
  content    Content[]
  expenses   Expense[]
  metrics    Metric[]
  tasks      Task[]
}

model Objective {
  id          String   @id @default(cuid())
  planId      String
  name        String
  description String?
  kpiType     String
  target      Float    @default(0)
  current     Float    @default(0)
  unit        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model Campaign {
  id           String    @id @default(cuid())
  planId       String
  brandId      String?
  name         String
  objective    String?
  startDate    DateTime
  endDate      DateTime
  budget       Float     @default(0)
  platforms    String    @default("")
  audience     String?
  assignedToId String?
  status       String    @default("مخطط")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  plan       Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  brand      Brand?    @relation(fields: [brandId], references: [id])
  assignedTo User?     @relation(fields: [assignedToId], references: [id])
  content    Content[]
  expenses   Expense[]
  metrics    Metric[]
  tasks      Task[]
}

model Content {
  id           String   @id @default(cuid())
  planId       String
  campaignId   String?
  title        String
  type         String
  platform     String
  date         DateTime
  assignedToId String?
  status       String   @default("فكرة")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  plan       Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  campaign   Campaign? @relation(fields: [campaignId], references: [id])
  assignedTo User?     @relation(fields: [assignedToId], references: [id])
}

model Expense {
  id          String   @id @default(cuid())
  planId      String
  campaignId  String?
  category    String
  description String?
  amount      Float
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plan     Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id])
}

model Metric {
  id          String   @id @default(cuid())
  planId      String
  campaignId  String?
  platform    String?
  reach       Int      @default(0)
  impressions Int      @default(0)
  views       Int      @default(0)
  engagement  Int      @default(0)
  leads       Int      @default(0)
  sales       Int      @default(0)
  revenue     Float    @default(0)
  spend       Float    @default(0)
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plan     Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id])
}

model Task {
  id           String    @id @default(cuid())
  planId       String
  campaignId   String?
  title        String
  description  String?
  assignedToId String?
  priority     String    @default("متوسطة")
  status       String    @default("جديدة")
  dueDate      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  plan       Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  campaign   Campaign? @relation(fields: [campaignId], references: [id])
  assignedTo User?     @relation(fields: [assignedToId], references: [id])
}

model User {
  id           String   @id @default(cuid())
  companyId    String?
  name         String
  email        String   @unique
  role         String?
  passwordHash String?
  accessRoleId String?
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company    Company?   @relation(fields: [companyId], references: [id])
  accessRole Role?      @relation(fields: [accessRoleId], references: [id])
  content    Content[]
  tasks      Task[]
  campaigns  Campaign[]
}

// Access control: a Role is a named, fully custom permission set an admin
// defines per company (not a fixed hardcoded list) — each RolePermission row
// says how much access that role has to one app section ("resource").
model Role {
  id        String   @id @default(cuid())
  companyId String
  name      String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       User[]
}

// level is one of: NONE | VIEW | EDIT (see src/lib/constants.ts)
model RolePermission {
  id       String @id @default(cuid())
  roleId   String
  resource String
  level    String @default("NONE")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource])
}

// Meta (Facebook) Marketing API connection — Phase 1 of the Meta integration:
// OAuth connect/disconnect only, no campaign/ad/insight data yet (see src/app/api/meta
// and src/app/actions/meta.ts). One connection per company (companyId is unique), so
// connecting again simply replaces the existing row rather than creating a second one.
// accessTokenEncrypted is AES-256-GCM ciphertext (see src/lib/meta/encryption.ts) —
// never a plaintext token — and is never returned to the client.
model MetaConnection {
  id                   String    @id @default(cuid())
  companyId            String    @unique
  accessTokenEncrypted String
  tokenExpiresAt       DateTime?
  scopes               String?
  metaUserId           String?
  metaUserName         String?
  connectedAt          DateTime  @default(now())
  lastSyncAt           DateTime?
  lastError            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  adAccounts MetaAdAccount[]
}

// One Meta connection can see several ad accounts (e.g. one per Brand — BYD,
// MG, ROX each have their own). Phase 2 only lists and links these accounts
// to a local Brand — no campaigns/insights are pulled through them yet.
// brandId is optional and unique: an account starts unassigned after a
// fetch, and at most one ad account maps to a given Brand at a time.
model MetaAdAccount {
  id            String   @id @default(cuid())
  connectionId  String
  brandId       String?  @unique
  metaAccountId String
  accountName   String
  currency      String?
  status        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  connection MetaConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  brand      Brand?          @relation(fields: [brandId], references: [id])
  campaigns  MetaCampaign[]

  @@unique([connectionId, metaAccountId])
}

// Phase 3: a read-only mirror of each ad account's campaigns from Meta —
// listed and shown in a separate "حملات Meta" tab, never merged into the
// local Campaign model and never editable here (no create/update/delete
// against Meta). daily_budget/lifetime_budget come back from the Graph API
// in the ad account's currency's minor unit (Meta applies a fixed x100
// scale for every currency), so they're divided by 100 before storing.
model MetaCampaign {
  id             String    @id @default(cuid())
  adAccountId    String
  metaCampaignId String
  name           String
  status         String?
  objective      String?
  dailyBudget    Float?
  lifetimeBudget Float?
  startTime      DateTime?
  stopTime       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  adAccount MetaAdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  adSets    MetaAdSet[]
  insights  MetaInsight[]

  @@unique([adAccountId, metaCampaignId])
}

// Phase 4: read-only mirror of a campaign's ad sets. targetingSummary is a
// short human-readable line built from a handful of common targeting fields
// (age range, genders, countries) — not the full raw Meta targeting JSON,
// which is large and mostly not useful to show as-is in this UI.
model MetaAdSet {
  id               String    @id @default(cuid())
  campaignId       String
  metaAdSetId      String
  name             String
  status           String?
  dailyBudget      Float?
  lifetimeBudget   Float?
  startTime        DateTime?
  stopTime         DateTime?
  targetingSummary String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  campaign MetaCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  ads      MetaAd[]

  @@unique([campaignId, metaAdSetId])
}

// Phase 4: read-only mirror of an ad set's ads, with whatever creative info
// the Graph API returns for it (name/thumbnail — no full creative spec).
model MetaAd {
  id                    String   @id @default(cuid())
  adSetId               String
  metaAdId              String
  name                  String
  status                String?
  creativeName          String?
  creativeThumbnailUrl  String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  adSet MetaAdSet @relation(fields: [adSetId], references: [id], onDelete: Cascade)

  @@unique([adSetId, metaAdId])
}

// Phase 5: daily performance numbers per campaign — kept in its own table,
// completely separate from the existing (manually-entered) Metric model, so
// nothing here ever touches a user's own hand-entered numbers or the
// existing Analytics calculations. One row per (campaign, day).
// CTR/CPC/CPM/CPL/frequency are derived at display time from these raw
// numbers (see src/lib/calculations.ts) rather than stored — same
// "real, derived calculations, never hard-coded" approach the rest of the
// app already follows, and it keeps this table from disagreeing with
// numbers Meta itself might round differently.
// leads/conversions are extracted from Meta's `actions` breakdown by
// action_type (best-effort — Meta's action taxonomy varies by ad account
// setup, see the sync code for exactly which types are matched).
model MetaInsight {
  id          String   @id @default(cuid())
  campaignId  String
  date        DateTime
  spend       Float    @default(0)
  impressions Int      @default(0)
  reach       Int      @default(0)
  clicks      Int      @default(0)
  linkClicks  Int      @default(0)
  leads       Int      @default(0)
  conversions Int      @default(0)
  videoViews  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign MetaCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
}

// ============================================================================
// SaaS Builder — Phase 1 foundation
// ============================================================================
// A second, independent product living in this repo (see AGENTS.md history):
// a generic multi-tenant Organization -> Project platform, unrelated to the
// Marketing Plan models above. Models are prefixed `Saas` (and mapped to
// `saas_*` tables) purely to avoid name collisions with the existing
// User/Role/RolePermission models — the two products do not share any data,
// auth, or tenancy. Everything below is intentionally minimal: only the
// entities Phase 1 needs (auth, org/project membership, RBAC, audit log).
// Data/Page/Form/Workflow/Automation engines are explicitly out of scope.

model SaasUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  image        String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organizationMemberships SaasOrganizationMember[]
  projectMemberships      SaasProjectMember[]
  auditLogs               SaasAuditLog[]
  createdDataRecords      SaasDataRecord[]         @relation("DataRecordCreatedBy")
  updatedDataRecords      SaasDataRecord[]         @relation("DataRecordUpdatedBy")
  createdPages            SaasPage[]               @relation("PageCreatedBy")
  updatedPages            SaasPage[]               @relation("PageUpdatedBy")

  @@map("saas_users")
}

model SaasOrganization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   SaasOrganizationMember[]
  projects  SaasProject[]
  roles     SaasRole[]
  auditLogs SaasAuditLog[]

  @@index([slug])
  @@map("saas_organizations")
}

model SaasOrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  roleId         String
  createdAt      DateTime @default(now())

  organization SaasOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         SaasUser         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         SaasRole         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("saas_organization_members")
}

// status: ACTIVE | ARCHIVED (validated in the application layer, see
// src/lib/saas/constants.ts — kept as a plain String for the same
// cross-provider-portability reason as the Marketing Plan models above).
model SaasProject {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?
  icon           String?
  status         String   @default("ACTIVE")
  settings       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  SaasOrganization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members       SaasProjectMember[]
  roles         SaasRole[]
  auditLogs     SaasAuditLog[]
  dataModels    SaasDataModel[]
  dataRelations SaasDataRelation[]
  pages         SaasPage[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("saas_projects")
}

model SaasProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  project SaasProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    SaasUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    SaasRole    @relation(fields: [roleId], references: [id])

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("saas_project_members")
}

// A Role can be scoped to an Organization, a Project, or neither (a
// system-wide template — organizationId and projectId both null). Phase 1
// only ever creates the six system-defined templates (see
// src/lib/saas/constants.ts ROLE_KEYS / seed script) with `system = true`
// and no organization/project scope, referenced by every membership row.
// `key` is a stable machine identifier for the system roles (e.g.
// "org_owner") so authorization code never has to match on the
// human-readable, potentially-renamed `name`.
model SaasRole {
  id             String   @id @default(cuid())
  organizationId String?
  projectId      String?
  key            String?  @unique
  name           String
  description    String?
  system         Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization        SaasOrganization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project              SaasProject?             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  permissions          SaasRolePermission[]
  organizationMembers  SaasOrganizationMember[]
  projectMembers       SaasProjectMember[]

  @@index([organizationId])
  @@index([projectId])
  @@map("saas_roles")
}

model SaasPermission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles SaasRolePermission[]

  @@map("saas_permissions")
}

model SaasRolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       SaasRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission SaasPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("saas_role_permissions")
}

model SaasAuditLog {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String?
  userId         String
  action         String
  entity         String
  entityId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization SaasOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      SaasProject?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         SaasUser         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([projectId])
  @@index([userId])
  @@index([createdAt])
  @@map("saas_audit_logs")
}

// ============================================================================
// SaaS Builder — Phase 2A: Data Model Builder (schema definition only)
// ============================================================================
// Lets a Project define its own Data Models (collections) and Fields
// (columns) through the UI, with no code written. Phase 2A is schema-only:
// no SaasDynamicRecord (row storage), no query/validation engine yet — that
// is Phase 2B, and it will build on top of these rows, which is why
// SaasDataModel.id / SaasDataField.id / .key / .type must stay stable once
// created (see src/services/saas/data-model.service.ts and
// data-field.service.ts).

model SaasDataModel {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  slug        String
  description String?
  icon        String?
  position    Int      @default(0)
  settings    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project       SaasProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fields        SaasDataField[]
  relationsFrom SaasDataRelation[] @relation("DataRelationFromModel")
  relationsTo   SaasDataRelation[] @relation("DataRelationToModel")
  records       SaasDataRecord[]

  @@unique([projectId, slug])
  @@index([projectId])
  @@map("saas_data_models")
}

// `key` is the stable machine identifier Phase 2B's storage/query engine
// will key a DynamicRecord's JSON payload on — set once at creation and
// never changed by renaming `name` (see src/lib/saas/slug.ts). Options,
// defaultValue, validation and settings are opaque JSON in Phase 2A: only
// stored and rendered back, never evaluated — no validation engine, no
// formulas (see AGENTS.md Phase 2A scope).
model SaasDataField {
  id           String   @id @default(cuid())
  modelId      String
  name         String
  key          String
  type         String
  required     Boolean  @default(false)
  unique       Boolean  @default(false)
  defaultValue Json?
  options      Json?
  validation   Json?
  position     Int      @default(0)
  settings     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  model         SaasDataModel      @relation(fields: [modelId], references: [id], onDelete: Cascade)
  relationsFrom SaasDataRelation[] @relation("DataRelationFromField")
  relationsTo   SaasDataRelation[] @relation("DataRelationToField")

  @@unique([modelId, key])
  @@index([modelId])
  @@map("saas_data_fields")
}

// A schema-only relation between two Data Models in the SAME project (never
// across projects — enforced in src/services/saas/data-relation.service.ts,
// not just the UI). fromField/toField anchor it to two existing fields; this
// row is the single source of truth for the relationship (see AGENTS.md
// section 17) — a Field never stores its own copy of relation data.
model SaasDataRelation {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  fromModelId String
  fromFieldId String
  toModelId   String
  toFieldId   String
  type        String
  settings    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   SaasProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromModel SaasDataModel @relation("DataRelationFromModel", fields: [fromModelId], references: [id], onDelete: Cascade)
  toModel   SaasDataModel @relation("DataRelationToModel", fields: [toModelId], references: [id], onDelete: Cascade)
  fromField SaasDataField @relation("DataRelationFromField", fields: [fromFieldId], references: [id], onDelete: Cascade)
  toField   SaasDataField @relation("DataRelationToField", fields: [toFieldId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([fromModelId])
  @@index([toModelId])
  @@map("saas_data_relations")
}

// ============================================================================
// SaaS Builder — Phase 2B: Dynamic Records
// ============================================================================
// One shared table stores rows for every Data Model in every project — no
// per-model Postgres table, no EAV. `data` is the record's field values
// keyed by SaasDataField.key (never .name), validated against the model's
// fields at the application layer before every write (see
// src/lib/saas/record-validation.ts). `id` is permanent and never derived
// from `data`, so relations and (later) the Page Builder can reference a
// record by id regardless of what its fields later become.
model SaasDataRecord {
  id          String   @id @default(cuid())
  modelId     String
  data        Json
  createdById String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  model     SaasDataModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  createdBy SaasUser      @relation("DataRecordCreatedBy", fields: [createdById], references: [id])
  updatedBy SaasUser?     @relation("DataRecordUpdatedBy", fields: [updatedById], references: [id])

  @@index([modelId])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("saas_data_records")
}

// ============================================================================
// SaaS Builder — Phase 3A: Page Builder Foundation (architecture only)
// ============================================================================
// A Page belongs to a Project; its content is a tree of SaasPageNode rows
// (self-relation via parentId), never a JSON blob and never React component
// state — the stored tree IS the page (see AGENTS.md Phase 3A). Deliberately
// the opposite storage shape from Phase 2B's single-JSON-column records: a
// page's structure needs per-node addressing, reparenting, and reordering,
// which a nested blob would make far harder to do safely and atomically.
// No publishing engine yet: `status` is inert metadata only.

model SaasPage {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  slug        String
  status      String   @default("DRAFT")
  createdById String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   SaasProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy SaasUser       @relation("PageCreatedBy", fields: [createdById], references: [id])
  updatedBy SaasUser?      @relation("PageUpdatedBy", fields: [updatedById], references: [id])
  nodes     SaasPageNode[]

  @@unique([projectId, slug])
  @@index([projectId])
  @@map("saas_pages")
}

// Exactly one node per page has `parentId = null` — the Root node (type
// "ROOT"), created transactionally with its Page and never deletable (see
// page-node.service.ts). `position` orders siblings under the same parent
// and is always explicitly rewritten on reorder/move — never inferred from
// createdAt. `type` is validated against the Component Registry
// (src/lib/saas/page-builder/component-registry.ts), the single source of
// truth for which component types exist and what `props`/`styles` they
// accept — never hardcoded here or in the UI.
model SaasPageNode {
  id        String   @id @default(cuid())
  pageId    String
  parentId  String?
  type      String
  props     Json     @default("{}")
  styles    Json     @default("{}")
  settings  Json     @default("{}")
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page     SaasPage       @relation(fields: [pageId], references: [id], onDelete: Cascade)
  parent   SaasPageNode?  @relation("PageNodeChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children SaasPageNode[] @relation("PageNodeChildren")

  @@index([pageId])
  @@index([parentId])
  @@map("saas_page_nodes")
}
