# Local/deployment PostgreSQL connection string.
# - Local development: point this at any Postgres instance you have (Docker, local install, etc).
# - Vercel deployment: do NOT rely on this committed placeholder — set DATABASE_URL as a real
#   Environment Variable in the Vercel project settings, using the connection string from your
#   Vercel Postgres storage tab.
DATABASE_URL="postgresql://user:password@localhost:5432/marketing_plan?schema=public"
